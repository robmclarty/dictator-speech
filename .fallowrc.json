{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "src/index.{ts,tsx,js,jsx}",
    "src/main.{ts,tsx,js,jsx}",
    "src/theme/motion.ts",
    "src/theme/icons.tsx",
    "src/app/copy.ts",
    "src/generator/compose.ts",
    "src/generator/picker.ts",
    "src/data/chunks.schema.ts"
  ],
  "rules": {
    "unused-dependencies": "warn"
  },
  "ignoreExports": [
    {
      "file": "src/theme/motion.ts",
      "exports": ["*"]
    },
    {
      "file": "src/theme/icons.tsx",
      "exports": ["*"]
    },
    {
      "file": "src/app/copy.ts",
      "exports": ["*"]
    },
    {
      "file": "src/generator/compose.ts",
      "exports": ["*"]
    },
    {
      "file": "src/generator/picker.ts",
      "exports": ["*"]
    },
    {
      "file": "src/data/chunks.schema.ts",
      "exports": ["*"]
    }
  ]
}
