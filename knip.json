{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "index.html",
    "src/main.tsx",
    "src/theme/motion.ts",
    "src/theme/icons.tsx",
    "src/app/copy.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "test/**/*.ts"],
  "ignoreBinaries": [],
  "ignoreDependencies": [],
  "ignoreExportsUsedInFile": true,
  "vite": {
    "config": ["vite.config.{ts,js}"]
  },
  "vitest": {
    "config": ["vitest.config.{ts,js}"]
  }
}
